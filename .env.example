# Copy to .env  (git-ignored). Shell variables take precedence over this file.

# Enables the juror pass (--judge), /api/judge and full-redesign mockups.
ANTHROPIC_API_KEY=

# Model for the juror and redesign. Default claude-opus-5-5; claude-sonnet-5-5 is cheaper.
DC_MODEL=claude-opus-5-5

# Where reports are written (default: ./out)
# DC_OUT=./out

# Port for `node cli.mjs serve` (default 4310)
# DC_PORT=4310
